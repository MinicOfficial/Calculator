#include <iostream>
#include <limits>
#include <cmath>

using namespace std;

// Hesap makinesinin destekleyebileceği azami (maksimum) mutlak değer
const double AZAMI_DEGER = 1000000000.0; // 1.000.000.000

// Girilen veya hesaplanan bir değerin sınırı aşıp aşmadığını kontrol eder
bool siniriAsiyorMu(double deger) {
    return fabs(deger) > AZAMI_DEGER;
}

// Giris akisi kapanmissa (Ctrl+D / Ctrl+Z veya boru hattinin sonu) programi
// duzgunce sonlandirir; aksi halde sonsuz donguye girilebilir
void girisKapaliysaCik() {
    if (cin.eof()) {
        cout << "\nGiris sonlandi. Programdan cikiliyor.\n";
        exit(0);
    }
}

// Kullanıcıdan geçerli bir sayı okur; sınırı aşarsa uyarı verip tekrar sorar
double sayiOku(const string& etiket) {
    double deger;
    while (true) {
        cout << etiket;
        while (!(cin >> deger)) {
            girisKapaliysaCik();
            cout << "Gecersiz giris! Lutfen bir sayi girin: ";
            cin.clear();
            cin.ignore(numeric_limits<streamsize>::max(), '\n');
        }

        if (siniriAsiyorMu(deger)) {
            cout << "Bu islem hesap makinesinin azami degerini asmaktadir!\n";
            continue;
        }
        return deger;
    }
}

int main() {
    cout << "========================================\n";
    cout << "           HESAP MAKINESI\n";
    cout << "  (Azami islem siniri: 1.000.000.000)\n";
    cout << "========================================\n";

    char devamMi = 'e';

    while (devamMi == 'e' || devamMi == 'E') {
        cout << "\n----------------------------------------\n";
        double sayi1 = sayiOku("1. sayiyi girin: ");

        char islem;
        cout << "Islem secin (+, -, *, /): ";
        cin >> islem;
        girisKapaliysaCik();

        double sayi2 = sayiOku("2. sayiyi girin: ");

        double sonuc = 0.0;
        bool gecerliIslem = true;

        switch (islem) {
            case '+':
                sonuc = sayi1 + sayi2;
                break;
            case '-':
                sonuc = sayi1 - sayi2;
                break;
            case '*':
                sonuc = sayi1 * sayi2;
                break;
            case '/':
                if (sayi2 == 0.0) {
                    cout << "Hata: Bir sayi sifira bolunemez!\n";
                    gecerliIslem = false;
                } else {
                    sonuc = sayi1 / sayi2;
                }
                break;
            default:
                cout << "Gecersiz islem! Lutfen +, -, * veya / girin.\n";
                gecerliIslem = false;
                break;
        }

        if (gecerliIslem) {
            if (siniriAsiyorMu(sonuc)) {
                cout << "Bu islem hesap makinesinin azami degerini asmaktadir!\n";
            } else {
                cout << "Sonuc: " << sonuc << "\n";
            }
        }

        cout << "\nBaska bir islem yapmak istiyor musunuz? (e/h): ";
        cin >> devamMi;
        girisKapaliysaCik();
    }

    cout << "\nHesap makinesinden cikildi. Iyi gunler!\n";
    return 0;
}
